    {
      "id": "mcp",
      "type": "backend",
      "label": "Upstream MCP",
      "sublabel": "constant-time check"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 204,
      "label": "At container start"
    },
    {
      "from": 232,
      "to": 446,
      "label": "Every authorized request"
    },
    {
      "from": 470,
      "to": 550,
      "label": "Rejected"
    }
  ],
  "messages": [
    {
