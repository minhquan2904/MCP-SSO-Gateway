    },
    {
      "participant": "gw",
      "from": 269,
      "to": 384,
      "type": "security"
    },
    {
      "participant": "mcp",
      "from": 401,
      "to": 440,
      "type": "backend"
    },
    {
      "participant": "nginx",
      "from": 482,
      "to": 544,
      "type": "frontend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Users hold one token",
      "items": [
        "Issued at /auth, 90-day expiry",
        "The static token never leaves the server: nginx adds it on the last hop",
        "Upstream still checks it: direct calls on the network are rejected"
      ]
    },
    {
      "dot": "cyan",
      "title": "One source of truth",
      "items": [
        "The upstream's own secret file, mounted read-only in both",
        "Rotate: rewrite the file in place, restart the upstream",
        "No copy to keep in sync"
      ]
    },
    {
      "dot": "rose",
      "title": "Rejected at the edge",
      "items": [
        "401: unknown, expired or revoked; 403: no grant",
        "Gateway or policy unreachable → fail closed",
        "Grant changes apply after a gateway restart"
      ]
    }
  ]
}
