  "cards": [
    {
      "dot": "emerald",
      "title": "One token, many servers",
      "items": [
        "The token identifies a person; nginx picks the target server, the client cannot",
        "Each server is authorized separately: user → role → server"
      ]
    },
    {
      "dot": "rose",
      "title": "Upstreams never see it",
      "items": [
        "MCP server: nginx swaps Authorization for that server's static token",
        "HTTP API: nginx strips Authorization, forwards only the user header",
        "401/403 return JSON with a how_to_fix hint"
      ]
    },
    {
      "dot": "amber",
      "title": "Fail closed",
      "items": [
        "Revoking a grant takes effect within the 60s cache",
        "Policy backend unreachable → deny; gateway down → fast 5xx",
        "Open streams survive a revoke; new requests are rejected"
      ]
    }
  ]
