# Example gateway configuration. Copy to .env (gitignored) or feed the compose
# deployment. Secrets are never written here: every secret is read from a file
# whose path is configured with a *_FILE key. Startup fails loudly on missing
# or placeholder values and error messages name the key, never the value.
#
# ── OIDC identity provider ────────────────────────────────────────────
# External HTTPS identity provider. Issuer exactly as it appears in the
# validated ID token; discovery is <issuer>/.well-known/openid-configuration.
MCP_GATEWAY_OIDC_ISSUER=https://idp.example.com
# Client id registered at the provider for this gateway's redirect URI
# (<MCP_GATEWAY_PUBLIC_BASE_URL>/auth/callback).
MCP_GATEWAY_OIDC_CLIENT_ID=mcp-gateway
# Secret file read at boot; must contain exactly one non-empty line.
MCP_GATEWAY_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client/client-secret
# Optional discovery override. Unset means <issuer>/.well-known/openid-configuration.
# Any non-default discovery URL, and any plain-HTTP issuer/discovery, is rejected
# unless MCP_GATEWAY_ALLOW_INSECURE_OIDC=true. Leave unset in production.
#MCP_GATEWAY_OIDC_DISCOVERY_URL=
# Demo-only escape hatch for plain-HTTP loopback deployments. Never true in production.
MCP_GATEWAY_ALLOW_INSECURE_OIDC=false

# ── Public URLs ───────────────────────────────────────────────────────
# Browser-facing base URL; must match the redirect URI registered at the provider.
MCP_GATEWAY_PUBLIC_BASE_URL=https://gateway.example.com

# ── Secrets ───────────────────────────────────────────────────────────
# Root of all secret directories. Registry upstream_token_file paths must be
# regular files below it (no symlinks) and distinct from the secrets below.
MCP_GATEWAY_SECRETS_DIR=/run/secrets
# Signs the session cookie; at least 32 non-whitespace UTF-8 bytes on one line.
MCP_GATEWAY_SESSION_SECRET_FILE=/run/secrets/gateway-session/session-secret

# ── Local state and policy ────────────────────────────────────────────
# Registry: server routing metadata. Policy: role/member grants. Both are
# loaded once at boot; grant changes require a restart.
MCP_GATEWAY_REGISTRY_FILE=/etc/mcp-gateway/registry.yaml
MCP_GATEWAY_POLICY_FILE=/etc/mcp-gateway/policy.yaml
# Writable directory for the token database and audit log files.
MCP_GATEWAY_DATA_DIR=/data

# ── Introspection boundary ────────────────────────────────────────────
# Exact hostnames (never IPs or CIDRs) allowed to call /introspect, resolved
# to addresses and checked against the TCP peer before any token lookup.
# Must name the nginx service that runs the auth_request subrequest.
MCP_GATEWAY_INTROSPECT_CALLERS=nginx

# ── Tuning ────────────────────────────────────────────────────────────
MCP_GATEWAY_TOKEN_TTL_DAYS=90
MCP_GATEWAY_AUDIT_MAX_BYTES=52428800
MCP_GATEWAY_SESSION_TTL_SECONDS=1800
# IANA time zone used to render timestamps in the web UI.
MCP_GATEWAY_DISPLAY_TZ=UTC
MCP_GATEWAY_LOG_LEVEL=info
